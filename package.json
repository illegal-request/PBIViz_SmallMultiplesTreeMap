  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "5.5.4"
  }
}
