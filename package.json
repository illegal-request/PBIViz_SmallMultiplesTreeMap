{
  "name": "pbiviz-smallmultiplestreemap",
  "description": "A custom Power BI visual that renders a grid of D3 treemaps, one per unique combination of grouping field values.",
  "version": "0.2.30.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illegal-request/PBIViz_SmallMultiplesTreeMap.git"
  },
