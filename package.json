    "start": "pbiviz start",
    "package": "pbiviz package && node scripts/rename-output.js",
    "lint": "npx eslint .",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "powerbi-visuals-api": "~5.3.0",
