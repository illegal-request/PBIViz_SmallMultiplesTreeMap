{
  "dataRoles": [
    {
      "name": "panelBy",
      "kind": "Grouping",
      "displayName": "Split Into Panels",
      "description": "One separate panel is created for each unique value — e.g. Region"
    },
    {
      "name": "groupBy",
      "kind": "Grouping",
      "displayName": "Group Into Tiles",
      "description": "Items within each panel are grouped into labeled tile sections — e.g. Product Line"
    },
    {
      "name": "label",
      "kind": "Grouping",
      "displayName": "Item Name",
      "description": "The name of each individual leaf block — e.g. Task Name"
    },
    {
      "name": "measure",
      "kind": "Measure",
      "displayName": "Block Size",
      "description": "Numeric value that determines the relative size of each block — e.g. Units Sold"
    },
    {
      "name": "colorBy",
      "kind": "Grouping",
      "displayName": "Color Category",
      "description": "Categorical field whose values determine each block's color — e.g. Priority Level"
    },
    {
      "name": "labelOverride",
      "kind": "Grouping",
      "displayName": "Block Display Name",
      "description": "Optional friendly name shown inside blocks. Item Name is still used for cross-filtering; this only changes the displayed text."
    },
    {
      "name": "tooltips",
      "kind": "Measure",
      "displayName": "Tooltips",
      "description": "Extra fields shown when hovering over a block. Also enables report-page tooltips."
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "panelBy" } },
            { "for": { "in": "groupBy" } },
            { "for": { "in": "label" } },
            { "for": { "in": "measure" } },
            { "for": { "in": "colorBy" } },
            { "for": { "in": "labelOverride" } },
            { "for": { "in": "tooltips" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "colorSlot0":  { "displayName": "Status Color", "properties": { "fill": { "displayName": "Color", "type": { "fill": { "solid": { "color": true } } } } } },
    "colorSlot1":  { "displayName": "Status Color", "properties": { "fill": { "displayName": "Color", "type": { "fill": { "solid": { "color": true } } } } } },
