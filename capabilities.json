          { "value": "wrap",     "displayName": "Word Wrap"     },
          { "value": "resize",   "displayName": "Resize to Fit" }
        ]}},
        "minHeight": { "displayName": "Min Tile Height to Show Label", "type": { "numeric": true } },
        "minWidth":  { "displayName": "Min Tile Width to Show Label",  "type": { "numeric": true } }
      }
    },
    "itemLabels": {
      "displayName": "Item Labels",
      "properties": {
        "show":      { "displayName": "Show Name",  "type": { "bool": true } },
        "showCount": { "displayName": "Show Count", "type": { "bool": true } },
        "fontSize":  { "displayName": "Font Size",  "type": { "formatting": { "fontSize": true } } },
        "bold":      { "displayName": "Bold",       "type": { "bool": true } },
        "align":     { "displayName": "Alignment",  "type": { "enumeration": [
