        "textOverflow":{ "displayName": "Text Overflow", "type": { "enumeration": [
          { "value": "clip",     "displayName": "Clip"          },
          { "value": "ellipsis", "displayName": "Truncate (…)"  },
          { "value": "wrap",     "displayName": "Word Wrap"     },
          { "value": "resize",   "displayName": "Resize to Fit" }
        ]}},
        "minWidth":  { "displayName": "Min Block Width to Show Label", "type": { "numeric": true } }
      }
    },
    "legend": {
      "displayName": "Legend",
      "properties": {
        "show":          { "displayName": "Show",           "type": { "bool": true } },
        "position":      { "displayName": "Position",       "type": { "enumeration": [
          { "value": "top",    "displayName": "Top"    },
          { "value": "bottom", "displayName": "Bottom" },
          { "value": "left",   "displayName": "Left"   },
          { "value": "right",  "displayName": "Right"  }
        ]}},
        "fontSize":      { "displayName": "Font Size",      "type": { "formatting": { "fontSize": true } } },
        "bold":          { "displayName": "Bold",           "type": { "bool": true } },
        "color":         { "displayName": "Font Color",     "type": { "fill": { "solid": { "color": true } } } },
        "showTitle":     { "displayName": "Show Title",     "type": { "bool": true } },
        "titleFontSize": { "displayName": "Title Font Size","type": { "formatting": { "fontSize": true } } },
        "titleBold":     { "displayName": "Title Bold",     "type": { "bool": true } },
        "titleColor":    { "displayName": "Title Font Color","type": { "fill": { "solid": { "color": true } } } }
      }
    },
    "grid": {
      "displayName": "Grid",
      "properties": {
        "columns": { "displayName": "Columns (0 = proportional, N = grid)", "type": { "numeric": true } },
        "padding": { "displayName": "Panel Padding (px)",                   "type": { "numeric": true } }
      }
    },
    "values": {
      "displayName": "Values",
      "properties": {
        "scale": {
          "displayName": "Size Scale",
          "type": {
            "enumeration": [
              { "value": "linear", "displayName": "Linear (exact)" },
              { "value": "sqrt",   "displayName": "Square Root (recommended)" },
              { "value": "log",    "displayName": "Logarithmic (most even)" }
            ]
          }
        }
      }
    },
    "detailPopup": {
      "displayName": "Detail Popup",
      "properties": {
        "enabled": { "displayName": "Show detail popup on click", "type": { "bool": true } }
      }
    },
    "tooltipBehavior": {
      "displayName": "Tooltip Options",
      "properties": {
        "persistent": { "displayName": "Persistent (Sticky)",        "type": { "bool":    true } },
        "maxHeight":  { "displayName": "Max Height (px)",            "type": { "numeric": true } }
      }
    },
    "panelBorder": {
      "displayName": "Panel Border",
      "properties": {
        "show":  { "displayName": "Show",       "type": { "bool": true } },
        "width": { "displayName": "Width (px)", "type": { "numeric": true } },
        "color": { "displayName": "Color",      "type": { "fill": { "solid": { "color": true } } } }
      }
    }
  },
  "supportsHighlight": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": ["tooltips"],
    "supportEnhancedTooltips": true
  },
  "privileges": []
}
